{
	"permissions": {
		"defaultMode": "plan",
		"allow": [],
		"deny": [
			"Bash(git *)",
			"Read(**/.env)",
			"Read(**/.env.*)",
			"Read(**/config/*.php)"
		]
	},
	"sandbox": {
		"enabled": true,
		"autoAllowBashIfSandboxed": false,
		"allowUnsandboxedCommands": false,
		"filesystem": {
			"denyRead": ["~/**/.env", "~/**/.env.*", "~/**/config/*.php"]
		}
	},
	"statusLine": {
		"type": "command",
		"command": "bash ~/.claude/statusline.sh"
	},
	"syntaxHighlightingDisabled": true,
	"modelSettings": {
		"claude-sonnet-5": {
			"effortLevel": "high"
		}
	},
	"theme": "custom:ansi"
}
